# Gemini LLM — get key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# Azure Cognitive Services Speech — key from Azure portal
AZURE_SPEECH_KEY=your-azure-speech-key-here

# Azure region where the Speech resource is deployed (e.g. centralindia, eastus)
AZURE_SPEECH_REGION=your-azure-region-here

# Google Cloud TTS service-account JSON as a single-line string (required on Railway/Docker)
# Locally this is read from secrets/aurora-tts-key.json instead
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}